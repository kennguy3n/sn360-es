# SN360-ES Environment Variables
# Copy to .env and adjust for your environment.
#
# ============================================================
# SECURITY: Never commit real secrets to this file.
# This file contains only empty/default values for local dev.
# Generate secrets with: openssl rand -base64 48
#
# Production hardening enforced at config-load time (validate()):
#   - PG_SSLMODE=disable is REFUSED in UAT/prod. Set
#     PG_SSLMODE=require (or verify-full) before promoting.
#   - CORS_ALLOWED_ORIGINS=* (wildcard) is REFUSED in UAT/prod.
#     Specify explicit origins (comma-separated) instead.
#   - The URL-rewriter passthrough encryptor (no KMS configured)
#     is REFUSED in UAT/prod. Set AWS_KMS_MASTER_KEY_ID, or set
#     KMS_USE_MOCK=true in non-prod for a deterministic mock key.
#   - NATS_TLS_INSECURE=true and SMTP_SKIP_VERIFY=true are also
#     REFUSED in UAT/prod.
# The matching defaults below are tuned for `ENVIRONMENT=local`;
# tighten them in your UAT/prod .env per the rules above.
# ============================================================

# --- Application ---
APP_NAME=sn360-es
ENVIRONMENT=local
LOG_LEVEL=info
LOG_FORMAT=json

# --- HTTP server ---
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
# Shorter than HTTP_READ_TIMEOUT so Slowloris-style header dripping is
# cut off before the request body even starts streaming.
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=30s
# Internal-only listener for the sme-dashboard Email Security console
# backend-for-frontend (/internal/tenants/{tid}/email-security/*). It
# reads the tenant from the URL path, so it MUST stay off the public
# plane — bind it to a port the network policy only exposes to the
# trusted dashboard-proxy. 0 (default) disables the listener entirely.
INTERNAL_HTTP_PORT=0
# Shared secret required in the X-SN360-Internal-Token header on the
# internal listener (defence-in-depth on top of network isolation).
# Empty = rely on network isolation alone — allowed in dev, but in
# UAT/prod the binary REFUSES to boot when INTERNAL_HTTP_PORT is set
# and this is empty, under 32 bytes, or low-entropy (same floor as the
# other HMAC-keyed secrets). Surrounding whitespace is stripped at load.
# Generate one with:
#   openssl rand -base64 48
INTERNAL_AUTH_TOKEN=

# --- Event bus selection ---
# Allowed values: nats | redis
EVENT_BUS_TYPE=nats

# --- NATS JetStream ---
NATS_URL=nats://127.0.0.1:4222
NATS_NAME=sn360-es
NATS_USER=
NATS_PASSWORD=
NATS_TOKEN=
NATS_CREDS_FILE=
NATS_TLS_CA=
NATS_TLS_CERT=
NATS_TLS_KEY=
NATS_TLS_INSECURE=false
NATS_RECONNECT_WAIT=2s
NATS_MAX_RECONNECTS=-1
NATS_REQUEST_TIMEOUT=5s
NATS_PUBLISH_RETRY_ATTEMPTS=3
NATS_PUBLISH_RETRY_DELAY=200ms
NATS_DEDUP_WINDOW=2m
NATS_REPLICAS=1
NATS_STORAGE=file
NATS_FETCH_BATCH_SIZE=50
NATS_FETCH_MAX_WAIT=200ms

# --- Redis (cache + optional event bus) ---
REDIS_ADDR=127.0.0.1:6379
# Matches the --requirepass setting in docker-compose.yml. Override
# with a real secret when running against a managed Redis.
REDIS_PASSWORD=sn360es-dev
REDIS_DB=0
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=4
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=2s
REDIS_WRITE_TIMEOUT=2s
REDIS_RECONNECT_TIMEOUT=30s
REDIS_MIN_RETRY_BACKOFF=100ms
REDIS_CONSUMER_BLOCK=0
REDIS_FETCH_BATCH_SIZE=10

# --- PostgreSQL ---
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=sn360es
PG_PASSWORD=sn360es
PG_DATABASE=sn360es
# UAT/prod MUST set PG_SSLMODE=require or PG_SSLMODE=verify-full;
# the value `disable` is refused at config-load time.
PG_SSLMODE=require
PG_MAX_OPEN_CONNS=40
PG_MAX_IDLE_CONNS=10
PG_CONN_MAX_LIFETIME=1h

# --- AWS / KMS / S3 ---
AWS_REGION=ap-southeast-1
AWS_KMS_MASTER_KEY_ID=
AWS_S3_BUCKET_CREDENTIALS=sn360es-credentials
KMS_USE_MOCK=true
KMS_MOCK_KEY_HEX=

# --- Rspamd ---
RSPAMD_URL=http://127.0.0.1:11333
RSPAMD_PASSWORD=
RSPAMD_TIMEOUT=5s
RSPAMD_CACHE_TTL=30m

# --- AI / Tier 2 LLM ---
AI_URL=http://127.0.0.1:9000
AI_API_KEY=
AI_TIMEOUT=30s
AI_CACHE_TTL=1h

# --- Tier 1 encoder ---
TIER1_URL=http://127.0.0.1:9100
TIER1_TIMEOUT=5s
TIER1_BATCH_SIZE=64
TIER1_PASS_THRESHOLD=20
TIER1_FLAG_THRESHOLD=60
# Relationship-aware tightening applied to Partner / Customer senders
# (PassBelow / FlagAbove are shifted by this offset). Must be <= 0;
# the platform default of -10 lowers both thresholds by 10 points so
# established Partner / Customer correspondents that nonetheless trip
# higher Tier 1 scores still get escalated. Shared by the per-message
# and batch evaluation paths.
TIER1_SUPPRESS_PARTNER=-10

# --- Bonsai sensitivity classifier (optional) ---
# When set, the tiered sensitivity classifier uses the Bonsai SLM as a
# second-pass classifier after the encoder. When blank the encoder
# result is used directly with keyword fallback.
# SENSITIVITY_BONSAI_URL=http://127.0.0.1:9200
# SENSITIVITY_BONSAI_TIMEOUT=30s

# --- Tier 0 gates ---
TIER0_SKIP_INTERNAL=true
TIER0_SKIP_VENDOR=true
TIER0_SKIP_RECURRING=true
TIER0_HIGH_VOLUME_RSPAMD_ONLY=true

# --- Circuit breakers ---
CB_FAILURE_THRESHOLD=5
CB_SUCCESS_THRESHOLD=2
CB_OPEN_TIMEOUT=30s

# --- Privacy / banner ---
PRIVACY_PSEUDONYMIZE_LOGS=true
# Generate with: openssl rand -base64 48
BANNER_TOKEN_SECRET=
BANNER_TOKEN_TTL=168h
BANNER_DEFAULT_LOCALE=en
URL_REWRITER_BASE=https://l.sn360.io

# --- Tier 2 / external LLM cache ---
SCORE_BLOCKED_THRESHOLD=85
SCORE_HIGH_RISK_THRESHOLD=70
SCORE_WARNING_THRESHOLD=50
SCORE_CAUTION_THRESHOLD=30
SCORE_INFO_THRESHOLD=15

# --- CORS ---
# UAT/prod MUST list explicit origin(s); the wildcard `*` is
# refused at config-load time. Comma-separated, no spaces.
# CORS_ALLOWED_ORIGINS=https://dashboard.example.com,https://admin.example.com

# --- SMTP (simulation emails) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_TIMEOUT=10s
SMTP_SKIP_VERIFY=false

# --- Google Workspace Setup Guide ---
# 1. Create a GCP project at console.cloud.google.com
# 2. Enable the Admin SDK API and Gmail API
# 3. Create a service account with domain-wide delegation
# 4. In Google Admin Console > Security > API Controls > Domain-wide Delegation,
#    add the service account client ID with scopes:
#    - https://www.googleapis.com/auth/admin.directory.user.readonly
#    - https://www.googleapis.com/auth/admin.directory.group.readonly
#    - https://www.googleapis.com/auth/gmail.modify
# 5. Set the variables below
# 6. Use GET /v1/onboarding/gws-setup-status?tenant_id=<id> to validate
GWS_SERVICE_ACCOUNT_JSON=
GWS_DELEGATED_ADMIN=
GWS_DOMAIN=
# GWS_GMAIL_BASE_URL=  # override for tests
# GWS_ADMIN_BASE_URL=  # override for tests
# OAuth web-app credentials for the self-service onboarding consent
# flow (separate from the domain-wide-delegation service account).
# GWS_OAUTH_CLIENT_ID=
# GWS_OAUTH_CLIENT_SECRET=

# --- Microsoft 365 ---
O365_CLIENT_ID=
O365_CLIENT_SECRET=
O365_TENANT_ID=
# O365_BASE_URL=       # override for tests
# O365_TOKEN_URL=      # override for tests
# O365_RESOLVE_NESTED_GROUPS=true  # use transitiveMemberOf for nested groups (default true)

# --- Zoho Mail Setup Guide ---
# 1. Register an application at https://api-console.zoho.com
#    (or the matching regional console: api-console.zoho.eu / .in / .com.au / .com.cn / .jp).
# 2. Choose "Server-based Application". Configure the redirect URI to match
#    your /v1/onboarding/callback URL.
# 3. Grant these scopes to the application:
#    - ZohoMail.messages.ALL
#    - ZohoMail.folders.ALL
#    - ZohoMail.tags.ALL
#    - ZohoMail.accounts.READ
#    - ZohoMail.organization.READ
# 4. Run the OAuth consent flow to obtain a long-lived refresh token (Zoho
#    issues these when the auth request sets access_type=offline; the SN360
#    onboarding handler does this automatically for the zoho_mail provider).
# 5. Find your Zoho org's zoid via GET https://mail.zoho.<tld>/api/organization
#    and put it in ZOHO_ORG_ID.
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=
# ZOHO_ORG_ID=
# ZOHO_DOMAIN=
# Data centre: com (US, default), eu, in, com.au, com.cn, jp. Selecting
# a value here picks the matching accounts.zoho.<tld> and mail.zoho.<tld>
# hostnames automatically; override ZOHO_BASE_URL / ZOHO_ACCOUNTS_URL only
# for tests or air-gapped proxies.
# ZOHO_DATA_CENTER=com
# ZOHO_BASE_URL=
# ZOHO_ACCOUNTS_URL=

# --- Fastmail (JMAP) Setup Guide ---
# 1. Log in to Fastmail, go to Settings > Privacy & Security > Integrations
#    > API tokens, and mint a new token with the "mail" scope
#    (urn:ietf:params:jmap:core + urn:ietf:params:jmap:mail).
# 2. Find your account ID by hitting GET https://api.fastmail.com/.well-known/jmap
#    with that token; the response includes the primary account ID.
# Fastmail uses static API tokens — no OAuth consent flow is involved.
# Note: Fastmail's directory model is limited (identities only, no groups);
# enterprise sensitivity classification will be weaker than for Gmail/O365.
# FASTMAIL_API_TOKEN=
# FASTMAIL_ACCOUNT_ID=
# FASTMAIL_BASE_URL=

# --- Amazon WorkMail Setup Guide ---
# 1. Create an IAM user (or assume an IAM role if running on EC2/ECS) with
#    these WorkMail and EWS permissions:
#      - workmail:ListUsers
#      - workmail:ListGroups
#      - workmail:DescribeUser
#      - workmail:DescribeGroup
#      - workmail:ListGroupMembers
# 2. Configure a WorkMail Access Control Rule that allows the IAM identity
#    to impersonate users via EWS for the SN360-ES service account email
#    (the EWS endpoint is signed with SigV4 against the workmail service).
# 3. Set the AWS region of the WorkMail organisation (one of us-east-1,
#    us-west-2, eu-west-1 at time of writing).
# Credentials below are optional: when left empty the standard AWS
# credential chain is used (env vars AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY, shared credentials file, EC2/ECS instance role).
# WORKMAIL_ORGANIZATION_ID=
# WORKMAIL_REGION=
# WORKMAIL_ACCESS_KEY_ID=
# WORKMAIL_SECRET_ACCESS_KEY=
# WORKMAIL_EWS_BASE_URL=
# Session token for AWS STS temporary credentials (AssumeRole,
# AssumeRoleWithWebIdentity, SSO, federated identities). Required
# alongside WORKMAIL_ACCESS_KEY_ID/SECRET_ACCESS_KEY when the keys
# are temporary; omit when using static long-lived IAM-user keys or
# the default credential chain (EC2/ECS instance role).
# WORKMAIL_SESSION_TOKEN=

# --- Ingestion ---
INGESTION_ENABLED=false
INGESTION_INTERVAL=30s
INGESTION_BATCH_SIZE=50
INGESTION_CONCURRENCY=10
INGESTION_LOCK_TTL=45s
INGESTION_INITIAL_BACKFILL=1h
# Expected `aud` claim on the Google Pub/Sub OIDC token attached to
# push deliveries — usually the full callback URL the subscription
# was created with (e.g. https://api.sn360.example.com/v1/push/gws).
# When unset, the Google push verifier rejects all callbacks.
INGESTION_PUSH_GOOGLE_AUDIENCE=

# --- Workers ---
WORKER_RELATIONSHIP_INTERVAL=4h
WORKER_VENDOR_DISCOVERY_INTERVAL=168h
WORKER_CLEANUP_INTERVAL=24h
WORKER_RETENTION_DAYS=90
WORKER_LOCK_TTL=5m
WORKER_DIRECTORY_SYNC_INTERVAL=6h

# --- Tier 1 batch mode ---
# Enable batch orchestrator for Tier 1 evaluation. Default: true.
# When true, the per-message evaluate consumer is suppressed and the
# BatchOrchestrator consumes es.evaluate.request. The orchestrator
# tolerates BOTH the canonical BatchMessage{Request, Signals} wrapper
# AND the legacy flat dto.EvaluateRequest shape on the same subject;
# legacy-shape arrivals are still processed but increment
# `tier1_batch_legacy_payload_total{tenant=...}` so operators can see
# which publishers still need to migrate. Set to false to keep the
# per-message path (e.g. while debugging Tier 1 batch latency).
# See docs/ARCHITECTURE.md "TIER1_BATCH_ENABLED wire-format dependency".
TIER1_BATCH_ENABLED=true

# --- Onboarding ---
# Generate with: openssl rand -base64 32
ONBOARDING_STATE_SECRET=
ONBOARDING_CALLBACK_URL=http://localhost:8080/v1/onboarding/callback
# Dedicated 32-byte hex AES-256 key for encrypting OAuth tokens at
# rest. Falls back to KMS_MOCK_KEY_HEX then to a key derived from
# ONBOARDING_STATE_SECRET. Set this in production to separate token
# encryption from state-signing.
# ONBOARDING_TOKEN_KEY_HEX=

# --- WS-5A.1 Platform NATS event bridge ---
# Publishes HighRisk+ / Blocked verdicts, quarantine actions, and
# escalation events to the sn360-security-platform `sn360-events`
# JetStream stream for SOC correlation, playbook execution, and
# OpenSearch indexing. All settings are gated behind
# PLATFORM_NATS_ENABLED so a stand-alone sn360-es deployment that
# isn't paired with the platform keeps its existing behaviour with
# no extra config and no new infrastructure dependency.
PLATFORM_NATS_ENABLED=false
# Comma-separated list of NATS server URLs for the platform cluster.
# Required when PLATFORM_NATS_ENABLED=true.
PLATFORM_NATS_URLS=
# Optional: path to a NATS user credentials file (.creds) issued by
# the platform's account JWT. Preferred over PLATFORM_NATS_TOKEN.
# PLATFORM_NATS_CREDS_FILE=
# Lower-priority auth fallback for environments that haven't migrated
# to credentials files yet.
# PLATFORM_NATS_TOKEN=
# Connection name advertised on the platform NATS for observability.
PLATFORM_NATS_NAME=sn360-es-bridge
# JetStream stream name the bridge publishes against. Must match the
# stream the platform's alert-forwarder binds its consumer to.
PLATFORM_NATS_STREAM=sn360-events
# Identifies this sn360-es deployment to the platform SOC. Mirrored
# into `cluster_id` and `agent.labels.sn360.cluster_id` on each event
# so multi-region fleets can attribute alerts back to the originating
# cluster. Defaults to APP_NAME when unset.
# PLATFORM_CLUSTER_ID=
# Optional TLS for the platform connection. Mutually compatible with
# the creds-file auth path.
# PLATFORM_NATS_TLS_CA=
# PLATFORM_NATS_TLS_CERT=
# PLATFORM_NATS_TLS_KEY=
# PLATFORM_NATS_TLS_INSECURE=false

# Reconnect / publish timing knobs. Defaults below mirror the values
# applied in bridge.Config.withDefaults() at runtime.
PLATFORM_NATS_RECONNECT_WAIT=2s

# PLATFORM_NATS_MAX_RECONNECTS controls how many times the NATS Go
# client retries the underlying TCP connection after a disconnect.
# Negative values mean "retry forever" — the safer default for a
# fire-and-forget bridge where silently dropping SOC events after a
# transient network blip would be a security regression.
#
# Setting this to 0 is REJECTED at boot. Go's int zero-value
# semantics make 0 indistinguishable from "unset" at the config
# layer, and the NATS Go client has no value that means "no
# reconnect" (every n < 0 maps to infinite, every n >= 0 maps to
# bounded). If you genuinely need bounded reconnects, use a positive
# N; if you genuinely want infinite (the default), use -1 or leave
# this commented.
PLATFORM_NATS_MAX_RECONNECTS=-1

# Per-call publish window before the bridge gives up on a single
# attempt. The full per-event retry budget is
# PLATFORM_NATS_PUBLISH_TIMEOUT × PLATFORM_NATS_PUBLISH_RETRIES.
# That budget MUST be ≤ PLATFORM_NATS_DEDUP_WINDOW (validated at
# boot) — see PLATFORM_NATS_DEDUP_WINDOW below for why.
PLATFORM_NATS_PUBLISH_TIMEOUT=3s
PLATFORM_NATS_PUBLISH_RETRIES=3

# PLATFORM_NATS_DEDUP_WINDOW is the operator-declared mirror of the
# platform-side `sn360-events` JetStream stream's
# `duplicate_window_seconds` (in sn360-security-platform under
# deploy/nats/streams.json). It is NOT consumed by the publisher
# itself — dedup is enforced platform-side via the deterministic
# MsgID `<tenant>:<msgID>:<subject>` we set on every publish. This
# declaration exists so validate() can refuse configurations where
# the bridge's own retry budget (PublishTimeout × PublishRetries)
# would outlast the platform dedup window: in that pathological
# setting, a late-succeeding retry from an earlier NATS redelivery
# would land AFTER the platform forgot the original MsgID and be
# accepted as a fresh message — producing a silent duplicate
# downstream in the correlation engine and every alert-forwarder
# OpenSearch index.
#
# The default 10m matches the FU-B platform-side stream config and
# leaves generous margin above the in-process consumer redelivery
# span for the bridge-publishing handlers in cmd/sn360-es/consumers*
# (MaxDeliver=3 × linear AckWait backoff: 30 + 60 + 90 = 180s, plus
# per-attempt publish window PublishTimeout × PublishRetries ≈ 9s).
#
# Setting this to 0 OPTS OUT of the dedup-budget validation entirely.
PLATFORM_NATS_DEDUP_WINDOW=10m
