# SN360-ES Environment Variables
# Copy to .env and adjust for your environment.

# --- Application ---
APP_NAME=sn360-es
ENVIRONMENT=local
LOG_LEVEL=info
LOG_FORMAT=json

# --- HTTP server ---
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s

# --- Event bus selection ---
# Allowed values: nats | redis
EVENT_BUS_TYPE=nats

# --- NATS JetStream ---
NATS_URL=nats://127.0.0.1:4222
NATS_NAME=sn360-es
NATS_USER=
NATS_PASSWORD=
NATS_TOKEN=
NATS_CREDS_FILE=
NATS_TLS_CA=
NATS_TLS_CERT=
NATS_TLS_KEY=
NATS_TLS_INSECURE=false
NATS_RECONNECT_WAIT=2s
NATS_MAX_RECONNECTS=-1
NATS_REQUEST_TIMEOUT=5s
NATS_PUBLISH_RETRY_ATTEMPTS=3
NATS_PUBLISH_RETRY_DELAY=200ms
NATS_DEDUP_WINDOW=2m
NATS_REPLICAS=1
NATS_STORAGE=file
NATS_FETCH_BATCH_SIZE=50
NATS_FETCH_MAX_WAIT=200ms

# --- Redis (cache + optional event bus) ---
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=4
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=2s
REDIS_WRITE_TIMEOUT=2s
REDIS_RECONNECT_TIMEOUT=30s
REDIS_MIN_RETRY_BACKOFF=100ms
REDIS_CONSUMER_BLOCK=0
REDIS_FETCH_BATCH_SIZE=10

# --- PostgreSQL ---
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=sn360es
PG_PASSWORD=sn360es
PG_DATABASE=sn360es
PG_SSLMODE=disable
PG_MAX_OPEN_CONNS=20
PG_MAX_IDLE_CONNS=5
PG_CONN_MAX_LIFETIME=1h

# --- AWS / KMS / S3 ---
AWS_REGION=ap-southeast-1
AWS_KMS_MASTER_KEY_ID=
AWS_S3_BUCKET_CREDENTIALS=sn360es-credentials
KMS_USE_MOCK=true
KMS_MOCK_KEY_HEX=

# --- Rspamd ---
RSPAMD_URL=http://127.0.0.1:11333
RSPAMD_PASSWORD=
RSPAMD_TIMEOUT=5s
RSPAMD_CACHE_TTL=30m

# --- AI / Tier 2 LLM ---
AI_URL=http://127.0.0.1:9000
AI_API_KEY=
AI_TIMEOUT=30s
AI_CACHE_TTL=1h

# --- Tier 1 encoder ---
TIER1_URL=http://127.0.0.1:9100
TIER1_TIMEOUT=5s
TIER1_BATCH_SIZE=64
TIER1_PASS_THRESHOLD=20
TIER1_FLAG_THRESHOLD=60

# --- Bonsai sensitivity classifier (optional) ---
# When set, the tiered sensitivity classifier uses the Bonsai SLM as a
# second-pass classifier after the encoder. When blank the encoder
# result is used directly with keyword fallback.
# SENSITIVITY_BONSAI_URL=http://127.0.0.1:9200
# SENSITIVITY_BONSAI_TIMEOUT=30s

# --- Tier 0 gates ---
TIER0_SKIP_INTERNAL=true
TIER0_SKIP_VENDOR=true
TIER0_SKIP_RECURRING=true
TIER0_HIGH_VOLUME_RSPAMD_ONLY=true

# --- Circuit breakers ---
CB_FAILURE_THRESHOLD=5
CB_SUCCESS_THRESHOLD=2
CB_OPEN_TIMEOUT=30s

# --- Privacy / banner ---
PRIVACY_PSEUDONYMIZE_LOGS=true
BANNER_TOKEN_SECRET=replace-me-with-a-strong-secret
BANNER_TOKEN_TTL=168h
BANNER_DEFAULT_LOCALE=en
URL_REWRITER_BASE=https://l.sn360.io

# --- Tier 2 / external LLM cache ---
SCORE_BLOCKED_THRESHOLD=85
SCORE_HIGH_RISK_THRESHOLD=70
SCORE_WARNING_THRESHOLD=50
SCORE_CAUTION_THRESHOLD=30
SCORE_INFO_THRESHOLD=15

# --- CORS ---
CORS_ALLOWED_ORIGINS=*

# --- SMTP (simulation emails) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_TIMEOUT=10s
SMTP_SKIP_VERIFY=false

# --- Google Workspace Setup Guide ---
# 1. Create a GCP project at console.cloud.google.com
# 2. Enable the Admin SDK API and Gmail API
# 3. Create a service account with domain-wide delegation
# 4. In Google Admin Console > Security > API Controls > Domain-wide Delegation,
#    add the service account client ID with scopes:
#    - https://www.googleapis.com/auth/admin.directory.user.readonly
#    - https://www.googleapis.com/auth/admin.directory.group.readonly
#    - https://www.googleapis.com/auth/gmail.modify
# 5. Set the variables below
# 6. Use GET /v1/onboarding/gws-setup-status?tenant_id=<id> to validate
GWS_SERVICE_ACCOUNT_JSON=
GWS_DELEGATED_ADMIN=
GWS_DOMAIN=
# GWS_GMAIL_BASE_URL=  # override for tests
# GWS_ADMIN_BASE_URL=  # override for tests
# OAuth web-app credentials for the self-service onboarding consent
# flow (separate from the domain-wide-delegation service account).
# GWS_OAUTH_CLIENT_ID=
# GWS_OAUTH_CLIENT_SECRET=

# --- Microsoft 365 ---
O365_CLIENT_ID=
O365_CLIENT_SECRET=
O365_TENANT_ID=
# O365_BASE_URL=       # override for tests
# O365_TOKEN_URL=      # override for tests

# --- Ingestion ---
INGESTION_ENABLED=false
INGESTION_INTERVAL=30s
INGESTION_BATCH_SIZE=50
INGESTION_CONCURRENCY=10
INGESTION_LOCK_TTL=45s
INGESTION_INITIAL_BACKFILL=1h

# --- Workers ---
WORKER_RELATIONSHIP_INTERVAL=4h
WORKER_VENDOR_DISCOVERY_INTERVAL=168h
WORKER_CLEANUP_INTERVAL=24h
WORKER_RETENTION_DAYS=90
WORKER_LOCK_TTL=5m
WORKER_DIRECTORY_SYNC_INTERVAL=6h

# --- Tier 1 batch mode ---
# Enable batch orchestrator for Tier 1 evaluation.
# When true, the per-message evaluate consumer is suppressed and the
# BatchOrchestrator consumes es.evaluate.request with BatchMessage payloads.
# IMPORTANT: upstream publishers must emit the matching wire format.
# See internal/docs/ARCHITECTURE.md "TIER1_BATCH_ENABLED wire-format dependency".
TIER1_BATCH_ENABLED=false

# --- Onboarding ---
ONBOARDING_STATE_SECRET=replace-me-with-32-byte-secret
ONBOARDING_CALLBACK_URL=http://localhost:8080/v1/onboarding/callback
# Dedicated 32-byte hex AES-256 key for encrypting OAuth tokens at
# rest. Falls back to KMS_MOCK_KEY_HEX then to a key derived from
# ONBOARDING_STATE_SECRET. Set this in production to separate token
# encryption from state-signing.
# ONBOARDING_TOKEN_KEY_HEX=
