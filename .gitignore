# Build artifacts
bin/
coverage.out
*.test
*.out

# Go module cache (just in case)
/vendor/

# Editor / OS noise
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# Local env / secrets
.env
.env.local
*.pem
*.key
credentials*.json

# Tier 2 model weights — never commit GGUF blobs. Downloaded at
# deploy time by deployments/llm/download-model.sh.
*.gguf
models/

# Generated corpus output: ~7,500 emails (multi-MB) is built on
# demand via `make generate-corpus`. The only checked-in slice is
# scripts/corpus/evaluation/sample.json so CI has something to
# validate against.
scripts/corpus/evaluation/*.json
!scripts/corpus/evaluation/sample.json
scripts/corpus/loadtest/*.json
!scripts/corpus/loadtest/README.md


# E2E test artifacts (logs, decision-trace JSON, postfix dumps).
# Generated per-run by `make test-e2e` / `tests/e2e/run.sh`;
# committing them creates stale evidence that misleads reviewers
# about the current code's behaviour and grows the repo with
# transient debug output.
tests/e2e/.artifacts/

# Python bytecode for the cost-model scripts in scripts/cost_model/.
# Generated locally by `python3 -m unittest`; never useful in the
# repo tree.
__pycache__/
*.pyc

# Binary built by `go run ./cmd/sn360-es-handler-coverage/` when
# invoked without `-o`. Matches at repo root only so the
# `cmd/sn360-es-handler-coverage/` source directory is still
# tracked.
/sn360-es-handler-coverage

# WS-4b corpus-eval reports: the harness writes per-run reports to
# testdata/corpus-eval/reports/{timestamp}.json. Only the baseline
# (testdata/corpus-eval/baseline.json) and the synthetic corpus
# (testdata/corpus-eval/synthetic.jsonl) are committed; the
# per-run reports are local artifacts.
testdata/corpus-eval/reports/
