{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.16/MicrosoftTeams.schema.json",
  "manifestVersion": "1.16",
  "version": "1.2.0",
  "id": "8cdd9e69-680e-40d1-9bb7-7dfa0bb33165",
  "developer": {
    "name": "ShieldNet 360",
    "websiteUrl": "https://sn360.example.com",
    "privacyUrl": "https://sn360.example.com/privacy",
    "termsOfUseUrl": "https://sn360.example.com/terms"
  },
  "icons": {
    "color": "icon-color.png",
    "outline": "icon-outline.png"
  },
  "name": {
    "short": "ShieldNet 360",
    "full": "ShieldNet 360 Email Security"
  },
  "description": {
    "short": "Plain-language phishing warnings as you read and send.",
    "full": "ShieldNet 360 quietly checks your email and warns you in plain language when something looks risky — a lookalike address, an unexpected outsider, or a message that may be a scam. It always tells you what to do next and never blocks legitimate work. Runs entirely against your organisation's ShieldNet 360 service; no message contents leave the mailbox."
  },
  "accentColor": "#255fe5",
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "validDomains": [
    "*.sn360.example.com"
  ],
  "composeExtensions": [],
  "extensions": [
    {
      "requirements": {
        "scopes": ["mail"],
        "capabilities": [
          { "name": "Mailbox", "minVersion": "1.11" }
        ]
      },
      "runtimes": [
        {
          "id": "sn360-presend-runtime",
          "type": "general",
          "code": {
            "page": "https://sn360.example.com/addin/outlook/presend.html",
            "script": "https://sn360.example.com/addin/outlook/presend.js"
          },
          "lifetime": "short",
          "actions": [
            {
              "id": "sn360-on-message-send",
              "type": "executeFunction",
              "displayName": "ShieldNet 360 safety check",
              "supportsNoItemContext": false
            },
            {
              "id": "sn360-on-message-recipients-changed",
              "type": "executeFunction",
              "displayName": "ShieldNet 360 recipient check"
            }
          ]
        },
        {
          "id": "sn360-preopen-runtime",
          "type": "general",
          "code": {
            "page": "https://sn360.example.com/addin/outlook/preopen.html",
            "script": "https://sn360.example.com/addin/outlook/preopen.js"
          },
          "lifetime": "short",
          "actions": [
            {
              "id": "sn360-on-message-read",
              "type": "executeFunction",
              "displayName": "ShieldNet 360 open check"
            }
          ]
        }
      ],
      "ribbons": [],
      "autoRunEvents": [
        {
          "events": [
            {
              "type": "messageSending",
              "actionId": "sn360-on-message-send",
              "options": {
                "sendMode": "promptUser"
              }
            },
            { "type": "messageRecipientsChanged", "actionId": "sn360-on-message-recipients-changed" },
            { "type": "messageRead",     "actionId": "sn360-on-message-read" }
          ]
        }
      ]
    }
  ]
}
